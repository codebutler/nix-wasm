Build libcanberra's GTK3 half against a WAYLAND-ONLY GTK (issue #145). The
guest's cross GTK3 has no X11 backend (no gdk/gdkx.h, no libX11), but
canberra-gtk.c / canberra-gtk-module.c unconditionally include the X11
headers and read X11-only window metadata (_NET_WM_DESKTOP /
_NET_CURRENT_DESKTOP / _XEMBED_INFO) that only decorates the sound-event
proplist. Guard those includes + the four X11-touching functions behind
GDK_WINDOWING_X11 (defined by gdkconfig.h only when the X11 backend is
compiled in) with faithful "not available" fallbacks (-1 desktop, not
XEMBED, no X11 XID property) — the same runtime answers the nixpkgs
GdkX11-runtime-check patch produces on a wayland session, but compilable
without the X11 SDK. No change on an X11-enabled GTK.

diff --git a/src/canberra-gtk-module.c b/src/canberra-gtk-module.c
--- a/src/canberra-gtk-module.c
+++ b/src/canberra-gtk-module.c
@@ -25,8 +25,10 @@
 #endif
 
 #include <gtk/gtk.h>
+#ifdef GDK_WINDOWING_X11
 #include <gdk/gdkx.h>
 #include <X11/Xatom.h>
+#endif
 
 #include "canberra-gtk.h"
 
@@ -300,6 +302,7 @@
 }
 
 static gint window_get_desktop(GdkDisplay *d, GdkWindow *w) {
+#ifdef GDK_WINDOWING_X11
         Atom type_return;
         gint format_return;
         gulong nitems_return;
@@ -325,9 +328,16 @@
                 XFree(data);
 
         return ret;
+#else
+        /* No X11 windowing system (wayland-only GTK): no _NET_WM_DESKTOP. */
+        (void) d;
+        (void) w;
+        return -1;
+#endif
 }
 
 static gint display_get_desktop(GdkDisplay *d) {
+#ifdef GDK_WINDOWING_X11
         Atom type_return;
         gint format_return;
         gulong nitems_return;
@@ -354,9 +364,15 @@
                 XFree(data);
 
         return ret;
+#else
+        /* No X11 windowing system (wayland-only GTK): no _NET_CURRENT_DESKTOP. */
+        (void) d;
+        return -1;
+#endif
 }
 
 static gboolean window_is_xembed(GdkDisplay *d, GdkWindow *w) {
+#ifdef GDK_WINDOWING_X11
         Atom type_return;
         gint format_return;
         gulong nitems_return;
@@ -394,6 +410,12 @@
                 XFree(data);
 
         return ret;
+#else
+        /* No X11 windowing system (wayland-only GTK): nothing is XEMBED. */
+        (void) d;
+        (void) w;
+        return FALSE;
+#endif
 }
 
 static void dispatch_sound_event(SoundEventData *d) {
