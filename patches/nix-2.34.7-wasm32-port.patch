+   chunk lists alive at once (decompression pulls from one while pushing
+   into the other) — letting the compressed side shrink as it's consumed
+   caps how much of that overlap is resident at any one instant. Do not
+   "simplify" this back to a single `std::string buffer` in either function
+   — that reintroduces exactly the high-order allocation this exists to
+   avoid. */
+struct ChunkSource : Source
+{
+    std::deque<std::string> & chunks;
+    size_t pos = 0;
