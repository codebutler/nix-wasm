+#include <pthread.h> /* server_child_thread() -- see server_connect() */
+#endif
 #else
 #include <winbase.h>
 #endif
@@ -540,7 +543,22 @@ server_stopconnecting (server * serv)
 		serv->joindelay_tag = 0;
 	}
 
-#ifndef WIN32
+#if defined(__wasm__)
+	/* No child PROCESS to kill -- see server_connect()'s pthread port
+	 * above. Closing childwrite is our cancellation signal: the resolver
+	 * thread's next write() fails with EBADF (fds are shared with a
+	 * pthread, unlike a forked process) and it falls through to its
+	 * `xit:` label and returns on its own. We deliberately do NOT
+	 * pthread_cancel() it -- it may be inside getaddrinfo()/
+	 * connect(), and cancelling mid-libc-resolver/socket call is not
+	 * guaranteed-safe. Disclosed behavioural difference from the forked
+	 * original, not a silent one: an in-flight resolve can keep running
+	 * in the background (harmlessly, its results are simply never read)
+	 * for up to its own timeout after the user cancels. */
+	close (serv->childwrite);
+	close (serv->childread);
+	serv->childtid_active = FALSE;
+#elif !defined(WIN32)
 	/* kill the child process trying to connect */
 	kill (serv->childpid, SIGKILL);
 	waitpid (serv->childpid, NULL, 0);
@@ -1473,6 +1491,30 @@ traverse_proxy (int print_fd, int sok, char *ip, int port, struct msproxy_state_
 
 /* this is the child process making the connection attempt */
 
+#if defined(__wasm__)
+/* wasm NOMMU has no fork()/vfork() (docs/process-model.md's spawn
+ * contract) -- but server_child() below never execs a second program, it
+ * just does blocking name resolution + connect() off the main GTK thread
+ * and reports progress back over the childwrite pipe, so there is no
+ * posix_spawn to port it to (rule 2 doesn't apply -- there's no exec).
+ * XChat's own WIN32 port already hits this exact wall (Windows has no
+ * fork() either) and solves it by running server_child() in a fresh
+ * CreateThread() that shares the parent's address space in place of a
+ * forked child process (see the #ifdef WIN32 branch in server_connect()
+ * below) -- we follow that same upstream precedent with a POSIX pthread,
+ * which is exactly as safe here: server_child() only touches the `serv`
+ * struct + the read-only `prefs` global and never touches GTK/fe_* state
+ * directly, identically to what the WIN32 thread already relies on. */
+static int server_child (server * serv);
+
+static void *
+server_child_thread (void *arg)
+{
+	server_child ((server *) arg);
+	return NULL;
+}
+#endif
+
 static int
 server_child (server * serv)
 {
@@ -1721,6 +1763,23 @@ server_connect (server *serv, char *hostname, int port, int no_login)
 	CloseHandle (CreateThread (NULL, 0,
 										(LPTHREAD_START_ROUTINE)server_child,
 										serv, 0, (DWORD *)&pid));
+#elif defined(__wasm__)
+	/* No fork() on this platform -- run server_child() in a pthread
+	 * instead of a forked child process. See the server_child_thread()
+	 * comment above for why this mirrors the WIN32 CreateThread branch
+	 * rather than needing a posix_spawn port. `pid` stays 0 (cosmetic
+	 * only -- see server.c:1127's status message and serv->childpid's
+	 * comment in xchat.h). */
+	{
+		pthread_t tid;
+
+		if (pthread_create (&tid, NULL, server_child_thread, serv) != 0)
+			return;
+		pthread_detach (tid);
+		serv->childtid = tid;
+		serv->childtid_active = TRUE;
+	}
+	pid = 0;
 #else
