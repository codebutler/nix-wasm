main.h declares `gboolean player_active;` — a TENTATIVE DEFINITION included
by main.c/gfx.c/prefs.c/theme.c, so under clang's default -fno-common every
includer defines the symbol (duplicate-symbol link errors). -fcommon is not
an option on wasm32 (the wasm object format has no common symbols; clang
ICEs). The real definition lives in main.c; the header gets extern.

--- a/src/main.h
+++ b/src/main.h
@@ -51,7 +51,7 @@
 
 extern PlayerID who_starts;
 
-gboolean player_active;
+extern gboolean player_active; /* defined in main.c; a tentative definition here duplicates the symbol in every includer under -fno-common */
 
 void game_reset (void);
 void process_move (int move);
