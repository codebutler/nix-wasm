# nix-wasm #192 (Track A follow-up, applied after 0023+0026 on mmu=true
# builds): a refcounted, per-inode cache of the physically-contiguous KERNEL
# copy of a wasm exec image (arch/wasm/mm/exec_image.c).
#
# asm/mmu.h documents that under the software MMU the engine reads the
# process's wasm bytes out of a kernel-owned buffer for the mm's ENTIRE
# lifetime (at exec, at a clone's first run, and lazily at first dlopen), so
# fs/binfmt_wasm.c used to alloc_pages_exact() + kernel_read() a FRESH
# ~order-14+ buffer on every single exec, even of the exact same on-disk
# file. A real build loop (autoconf's `configure` re-invoking the ~57 MB
# clang.wasm dozens of times, #192/#193) manufactures exactly the alloc/free
# churn that fragments this arch's buddy heap — no hardware MMU to make
# fragmentation invisible — until an alloc fails outright; empirically an
# Nth-exec cliff around the 5th-7th large exec.
#
# Fix: key the buffer by the identity of the underlying FILE and refcount it
# — 1 ref for the cache's own slot, 1 per mm currently exec'd from it
# (mm_context_t.image replaces the old bare bin_copy/bin_size pair). Every
# exec of the SAME bytes after the first is a spinlock-only cache hit: no
# allocation, no read, no ~57 MB squashfs-zstd re-decompression.
#
# CORRECTNESS: the identity key is (s_dev, i_ino) — deliberately NOT treated
# as unique. 32-bit overlayfs (this guest's wasm32 /nix — CONFIG_OVERLAY_FS_
# XINO_AUTO depends on 64BIT) discards the layer fsid and stores the raw
# underlying ino, so squashfs-lower/ramfs-upper ino collisions are routine,
# not a rare edge case; Nix also normalizes every store file's mtime to a
# fixed epoch, and store paths are fixed-length, so size/mtime discriminate
# almost nothing on /nix either. The validator that actually bounds
# staleness is a memcmp of the cached bytes against the caller's bprm->buf
# (the file's own leading BINPRM_BUF_SIZE==256 bytes, already read by
# generic exec code) — see the struct comment in exec_image.h for the full
# accounting, including that validator's own honest residual (only the
# first 256 bytes are compared). wasm_exec_image_get() now returns
# ERR_PTR()-encoded errors (not a blanket -ENOMEM) so a short read
# propagates distinctly from an allocation failure, and takes the caller's
# already-validated whole_size as the SOLE size source (no second, possibly-
# divergent i_size_read() sample inside the cache).
#
# RECLAIM: a shrinker alone is not sufficient to serve the very allocation
# this cache exists to unblock — the direct-reclaim path that runs a
# shrinker can bail (compaction_ready()/nr_to_reclaim satisfied elsewhere)
# before ever invoking it, for a costly high-order request exactly like
# this one's. So the miss path SYNCHRONOUSLY evicts idle (cache-only-
# referenced) entries LRU-first and retries the allocation once on
# failure — the actual heuristic-independent mechanism — and a byte cap
# (160 MB, sized against this guest's ~1.75-2 GiB RAM) is enforced at
# every insert, evicting only the EXCESS over the cap LRU-first (not every
# idle entry, which would cold-start warm entries like clang's own image
# on every over-cap insert), so steady-state retention is bounded even
# with no memory pressure at all. The registered shrinker stays as
# best-effort BACKGROUND reclaim for OTHER allocations' pressure; full
# design in the arch/wasm/mm/exec_image.c file comment.
#
# The load also MOVES ahead of begin_new_exec(bprm) (bprm's point of no
# return): an allocation/read/parse failure is now a clean execve() ==
# -ENOMEM/-error instead of the post-point-of-no-return task kill every
# other failure past that call already needs. KNOWN TRADEOFF: for a
# DIFFERENT-binary exec this can transiently raise the peak (old + new image
# both resident for a moment, where before the old was already freed) — the
# evict-and-retry path above is the backstop for that raised peak; see the
# exec_image.c file comment for the full accounting. "Halving the peak" (a
# compiler driver + its wasm-ld sharing one buffer) is a same-file property,
# unaffected by this tradeoff.
#
# Bonus correctness fix forced by the refactor: dup_mmap() (a fork) used to
# rely on the generic no-op arch_dup_mmap() (<asm-generic/mm_hooks.h>), which
# left a forked child's mm->context BLANK (init_new_context() zeroes it)
# while the child's copied mm->start_code/end_code still pointed into the
# PARENT's buffer — a parent that exited before the child's first run or a
# later dlopen left the child reading freed pages. mmu_context.h now defines
# an explicit arch_dup_mmap() that takes a real reference on the child's
# behalf, closing the hole as a side effect of making the buffer refcounted
# at all.
#
# No ENGINE_ABI change: bin_start/bin_end (now image->buf/image->buf_size)
# is still a single contiguous kernel byte range from the engine's point of
# view; which mm's exec caused that range to be populated is invisible to it.
--- /dev/null
+++ b/arch/wasm/include/asm/exec_image.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_WASM_EXEC_IMAGE_H
+#define _ASM_WASM_EXEC_IMAGE_H
+
+#ifdef CONFIG_MMU
+
+#include <linux/list.h>
+#include <linux/refcount.h>
+#include <linux/time64.h>
+#include <linux/types.h>
+
+struct file;
+
+/*
+ * Refcounted, per-inode cache of the physically-contiguous KERNEL copy of a
+ * wasm exec image (#192). See arch/wasm/mm/exec_image.c for the full design
+ * write-up; the short version: asm/mmu.h documents that the engine consumes
+ * the exec'd binary's BYTES straight out of this buffer for the mm's ENTIRE
+ * lifetime (at exec, at a clone's first run, and lazily at first dlopen), so
+ * a naive one-buffer-per-mm scheme forces one order-14+ alloc_pages_exact per
+ * exec. A build loop re-invoking the SAME 57 MB compiler dozens of times
+ * manufactures exactly the alloc/free churn that fragments this arch's
+ * buddy heap until an alloc fails outright — sharing one buffer across every
+ * mm that execs the same on-disk file removes the churn at the root.
+ */
+struct wasm_exec_image {
+	/* MRU-ordered (list_add/list_move both push to the head); the
+	 * shrinker below walks it tail-first for LRU eviction. Protected by
+	 * wasm_exec_image_lock — see the .c file for why it's a spinlock. */
+	struct list_head lru;
+
+	/* 1 reference for the cache's own slot (dropped when unhashed by a
+	 * validator mismatch or evicted, either synchronously on an alloc
+	 * failure or by the shrinker) + 1 per mm currently using it
+	 * (mm_context_t.image, taken in wasm_exec_image_get() and copied
+	 * across fork by arch_dup_mmap()). The buffer is freed only once
+	 * this hits zero, i.e. only after BOTH the cache has let go AND
+	 * every mm that ever execed it has torn down. */
+	refcount_t refs;
+
+	/*
+	 * Identity key: VALUES read out of the inode at lookup time, never a
+	 * pinned `struct inode *`. Deliberately no igrab()/iget(): pinning
+	 * would leak into "VFS: busy inodes on unmount" on the served
+	 * squashfs/9P mounts, and it wouldn't even buy correctness — see
+	 * below.
+	 *
+	 * (s_dev, i_ino) is NOT a reliably unique key on this guest's own
+	 * /nix. file_inode(bprm->file) on the overlay mount is the OVERLAY
+	 * inode, and ovl_map_ino() (fs/overlayfs/inode.c) only remaps it to
+	 * something collision-resistant when xino is active; wasm32 is a
+	 * 32-bit arch, CONFIG_OVERLAY_FS_XINO_AUTO depends on 64BIT, and
+	 * ovl_xino_bits() is therefore structurally 0 here — the RAW
+	 * underlying layer ino is stored with its layer fsid discarded. The
+	 * squashfs lower and ramfs upper both hand out small ino numbers
+	 * starting near 1, so an (s_dev, i_ino) collision between an
+	 * unrelated squashfs file and a ramfs file is routine, not a rare
+	 * edge case. The validators below are what actually carry the
+	 * correctness burden, not this key — treat (s_dev, i_ino) as a hash
+	 * BUCKET selector, not an identity proof.
+	 */
+	dev_t s_dev;
+	unsigned long i_ino;
+
+	/*
+	 * Validators, checked in this file's image_validators_match() in
+	 * increasing cost order — NONE of the cheap ones is trustworthy
+	 * alone on this guest, which is why the memcmp exists:
+	 *
+	 *   - size: on /nix, store paths are fixed-length, so two different
+	 *     builds of the same derivation (or two unrelated derivations
+	 *     that happen to produce same-length outputs) are routinely
+	 *     byte-identical in SIZE. Discriminates almost nothing here.
+	 *   - mtime: Nix normalizes every store file's mtime to the fixed
+	 *     epoch+1 timestamp, so every /nix file has the SAME mtime —
+	 *     discriminates nothing there at all. Off /nix (ramfs scratch
+	 *     binaries, e.g. a locally-compiled a.out) mtime is live but
+	 *     coarse (ramfs's clock granularity is on the order of a
+	 *     millisecond tick): a same-inode, same-size rewrite within one
+	 *     tick is invisible to it.
+	 *   - i_version: present in the struct for filesystems that support
+	 *     it, but effectively DORMANT on this guest today — none of
+	 *     squashfs, ramfs, or overlayfs set SB_I_VERSION here, so
+	 *     have_i_version is false for every exec this guest performs in
+	 *     practice. Kept so a future fs that does enable it is used for
+	 *     free, not because it currently helps.
+	 *   - memcmp of the leading bytes (done in wasm_exec_image_get()
+	 *     against the caller's bprm->buf, NOT stored on this struct):
+	 *     this is the validator that actually bounds staleness on this
+	 *     guest. Its own honest limit: only the first
+	 *     min(size, BINPRM_BUF_SIZE) == min(size, 256) bytes are
+	 *     compared (that's all binfmt already has read into bprm->buf
+	 *     before any binfmt handler runs), so two DIFFERENT files that
+	 *     happen to share both size and a 256-byte prefix — astronomically
+	 *     unlikely for real compiled wasm binaries, but not provably
+	 *     impossible — would still alias. Nothing short of a full-file
+	 *     content hash closes that residual, and that would tax the
+	 *     *hit* path this cache exists to make free. A validator
+	 *     mismatch at ANY of these checks is treated as a MISS: the
+	 *     stale entry is unhashed (see wasm_exec_image_get()) and a
+	 *     fresh copy is loaded, exactly as if the key had never matched.
+	 */
+	loff_t size;
+	struct timespec64 mtime;
+	bool have_i_version;	/* IS_I_VERSION(inode) at load time */
+	u64 i_version;		/* meaningful only if have_i_version */
+
+	void *buf;		/* alloc_pages_exact(), buf_size bytes */
+	unsigned long buf_size;
+};
+
+/*
+ * Look up (or load fresh) the cached image backing bprm->file, taking a
+ * reference on the caller's behalf. `whole_size` is the exact byte size the
+ * caller intends to exec (already validated against i_size by the caller;
+ * used verbatim as both the size validator and the allocation size — this
+ * function does NOT re-sample i_size itself, so there is exactly one source
+ * of truth for "how big is this image" and no risk of it drifting from a
+ * second, later i_size_read() sample under this file's caller). `head` must
+ * point at (at least) `head_len` bytes of the file's own leading content —
+ * the caller's bprm->buf, already populated by generic exec code before any
+ * binfmt handler runs — used to memcmp-validate a candidate cache hit (see
+ * the struct comment above).
+ *
+ * Returns a valid pointer on success, or an ERR_PTR() on failure — check
+ * with IS_ERR()/PTR_ERR(), standard kernel pointer-or-errno convention (NOT
+ * a bare NULL-on-failure: a short kernel_read() propagates as ERR_PTR(-EIO),
+ * a genuine negative kernel_read() return propagates as ERR_PTR(that errno),
+ * and a failed allocation propagates as ERR_PTR(-ENOMEM) — the caller can
+ * tell these apart instead of collapsing everything to -ENOMEM). MUST be
+ * called BEFORE begin_new_exec(bprm): once begin_new_exec() runs, this
+ * process has passed its point of no return and a later failure can only be
+ * reported by killing the task (see fs/binfmt_wasm.c load_wasm_file())
+ * instead of a clean execve() == -error.
+ */
+struct wasm_exec_image *wasm_exec_image_get(struct file *file,
+		unsigned long whole_size, const void *head, size_t head_len);
+
+/* Drop a reference. Frees the buffer the instant refs reaches zero, i.e.
+ * once the entry is both unhashed (evicted/replaced) AND no mm references it
+ * any longer. `image` may be NULL (mirrors kfree()/free_pages_exact() taking
+ * a NULL/absent pointer gracefully — callers on an error path that never got
+ * an image can call this unconditionally). */
+void wasm_exec_image_put(struct wasm_exec_image *image);
+
+/* Take an extra reference on an ALREADY-HELD image. Used by arch_dup_mmap()
+ * (arch/wasm/include/asm/mmu_context.h): a forked child's mm starts out
+ * sharing the parent's cached image outright, rather than the parent's raw
+ * mm->context.image pointer being blindly memcpy'd into the child with no
+ * refcount to show for it — see the mmu_context.h comment for the
+ * use-after-free that would otherwise result. */
+static inline struct wasm_exec_image *wasm_exec_image_ref(struct wasm_exec_image *image)
+{
+	if (image)
+		refcount_inc(&image->refs);
+	return image;
+}
+
+#endif /* CONFIG_MMU */
+
+#endif /* _ASM_WASM_EXEC_IMAGE_H */
