+static DEFINE_SPINLOCK(wasm_exec_image_lock);	/* protects the list below */
+static LIST_HEAD(wasm_exec_image_lru);		/* MRU-first */
+static DEFINE_MUTEX(wasm_exec_image_load_mutex); /* serializes miss loads */
+
+/*
+ * Steady-state retention cap for IDLE (cache-only-referenced) entries,
+ * enforced at insert regardless of memory pressure (reclaim mechanism 2 in
+ * the file comment above). 160 MB covers a large compiler + its linker (or a
+ * second large compiler) staying warm at once, with headroom on the
+ * ~1.75-2 GiB CONFIG_BOOT_MEM_PAGES this guest boots with — see kernel.nix's
+ * CONFIG_BOOT_MEM_PAGES comment for the guest RAM budget this is sized
+ * against. Entries pinned by a live mm (refcount > 1) are NEVER evicted to
+ * satisfy this cap; only idle ones count against it or get evicted for it.
+ */
+#define WASM_EXEC_IMAGE_CACHE_CAP_BYTES (160UL * 1024 * 1024)
+
+static bool image_key_matches(const struct wasm_exec_image *img,
+		dev_t s_dev, unsigned long i_ino)
+{
+	return img->s_dev == s_dev && img->i_ino == i_ino;
+}
+
+/*
+ * `head`/`head_len` is the caller's bprm->buf — the file's own leading bytes,
+ * already read by generic exec code before any binfmt handler runs, NOT
+ * anything sourced from the cache. Checked LAST (memcmp is by far the most
+ * expensive of these): a size/mtime/i_version mismatch short-circuits before
+ * ever touching img->buf.
+ */
+static bool image_validators_match(const struct wasm_exec_image *img,
+		loff_t size, struct timespec64 mtime,
+		bool have_i_version, u64 i_version,
+		const void *head, size_t head_len)
+{
+	size_t cmp_len;
+
+	if (img->size != size)
+		return false;
+	if (img->mtime.tv_sec != mtime.tv_sec ||
+			img->mtime.tv_nsec != mtime.tv_nsec)
+		return false;
+	/*
+	 * Only compared when BOTH the cached entry and this lookup have
+	 * i_version (IS_I_VERSION is a per-superblock property, so the two
+	 * sides can only disagree if s_dev itself changed meaning, which
+	 * image_key_matches() already rules out). Dormant on this guest
+	 * today (see the struct comment in exec_image.h) — kept for a
+	 * future fs that sets SB_I_VERSION.
+	 */
+	if (have_i_version && img->have_i_version &&
+			img->i_version != i_version)
+		return false;
+
+	/*
+	 * The validator that actually carries the correctness burden on
+	 * this guest (see the struct + get() comments in exec_image.h for
+	 * why size/mtime/i_version alone are not trustworthy here). `size`
+	 * already matched above, so img->buf_size == size == img->size —
+	 * bounding cmp_len by img->buf_size is defense-in-depth, not a
+	 * distinct case.
+	 */
+	cmp_len = min_t(size_t, head_len, img->buf_size);
+	if (memcmp(img->buf, head, cmp_len) != 0)
+		return false;
+
+	return true;
+}
+
+/* Caller holds no lock and img->refs is provably 0 (either just dropped to
+ * 0 by refcount_dec_and_test(), or freshly allocated and never published).
+ * Frees the buffer and the tracking struct. */
+static void wasm_exec_image_release(struct wasm_exec_image *img)
+{
+	free_pages_exact(img->buf, img->buf_size);
+	kfree(img);
+}
+
+void wasm_exec_image_put(struct wasm_exec_image *image)
+{
+	if (!image)
+		return;
+	if (refcount_dec_and_test(&image->refs))
+		wasm_exec_image_release(image);
+}
+
+/*
+ * Evict up to `max_bytes` worth of IDLE (refcount==1, i.e. cache-only-
+ * referenced) entries, LRU-first, and drop the cache's own reference to
+ * each. Used both synchronously on an allocation failure (evict everything
+ * idle: max_bytes == ULONG_MAX) and to enforce the steady-state byte cap on
+ * every insert (evict just enough to get back under the cap). Returns the
+ * number of bytes evicted. Never touches an entry a live mm still
+ * references — see the file comment's "reclaim" section.
+ */
+static unsigned long wasm_exec_image_evict_idle(unsigned long max_bytes)
+{
+	LIST_HEAD(dead);
+	struct wasm_exec_image *img, *tmp;
+	unsigned long evicted = 0;
+
+	spin_lock(&wasm_exec_image_lock);
+	/* MRU-first list (list_add()/list_move() both push to head); walk
+	 * tail-first to take the LEAST-recently-used idle entry first. */
+	list_for_each_entry_safe_reverse(img, tmp, &wasm_exec_image_lru, lru) {
+		if (evicted >= max_bytes)
+			break;
+		if (refcount_read(&img->refs) != 1)
+			continue; /* pinned by a live mm; not ours to evict */
+		list_move(&img->lru, &dead);
+		evicted += img->buf_size;
+	}
+	spin_unlock(&wasm_exec_image_lock);
+
+	list_for_each_entry_safe(img, tmp, &dead, lru) {
+		list_del(&img->lru);
+		/* refcount is still 1 here: nothing outside this function can
+		 * have bumped it back up once removed from the list (lookups
+		 * only find entries reachable from the list). Release drops
+		 * straight to 0. */
+		wasm_exec_image_release(img);
+	}
+
+	return evicted;
+}
+
+/* Sum of buf_size across every IDLE entry currently in the cache. */
+static unsigned long wasm_exec_image_idle_bytes(void)
+{
+	struct wasm_exec_image *img;
+	unsigned long bytes = 0;
+
+	spin_lock(&wasm_exec_image_lock);
+	list_for_each_entry(img, &wasm_exec_image_lru, lru) {
+		if (refcount_read(&img->refs) == 1)
+			bytes += img->buf_size;
+	}
+	spin_unlock(&wasm_exec_image_lock);
+	return bytes;
+}
+
+/*
+ * Unhash a same-key entry whose validators no longer match (the file on
+ * disk changed under us, e.g. a rebuilt binary at the same path). Drops the
+ * cache's OWN reference; any mm still running the OLD bytes keeps its own
+ * reference and keeps them valid until it exits, exactly as real Linux
+ * leaves a running program's text mapped after the backing inode's content
+ * changes underneath it. Returns true if a stale entry was found and
+ * unhashed (there is at most one, since the key is unique in the list).
+ * Takes wasm_exec_image_lock itself — NOT called with it already held.
+ */
+static bool unhash_stale_and_put(dev_t s_dev, unsigned long i_ino,
+		loff_t size, struct timespec64 mtime,
+		bool have_i_version, u64 i_version,
+		const void *head, size_t head_len)
+{
+	struct wasm_exec_image *img;
+
+	spin_lock(&wasm_exec_image_lock);
+	list_for_each_entry(img, &wasm_exec_image_lru, lru) {
+		if (!image_key_matches(img, s_dev, i_ino))
+			continue;
+		if (image_validators_match(img, size, mtime, have_i_version,
+				i_version, head, head_len)) {
+			spin_unlock(&wasm_exec_image_lock);
+			return false; /* not stale after all */
+		}
+		list_del(&img->lru);
+		spin_unlock(&wasm_exec_image_lock);
+		wasm_exec_image_put(img); /* the cache's own reference */
+		return true;
+	}
+	spin_unlock(&wasm_exec_image_lock);
+	return false;
+}
+
+struct wasm_exec_image *wasm_exec_image_get(struct file *file,
+		unsigned long whole_size, const void *head, size_t head_len)
+{
+	struct inode *inode = file_inode(file);
+	dev_t s_dev = inode->i_sb->s_dev;
+	unsigned long i_ino = inode->i_ino;
+	/*
+	 * `whole_size` (the CALLER's already-validated i_size sample) is the
+	 * single source of truth for this image's size — used verbatim as
+	 * both the validator and the allocation/buf_size. Deliberately NOT
+	 * re-sampling i_size_read(inode) here: a second sample could diverge
+	 * from the caller's (e.g. a revalidating network fs like 9P) and
+	 * store a validator that doesn't match the bytes actually read.
+	 */
+	loff_t size = (loff_t)whole_size;
+	struct timespec64 mtime = inode_get_mtime(inode);
+	bool have_i_version = IS_I_VERSION(inode);
+	/* peek, not query: query_iversion() flags the value to be bumped on
+	 * the NEXT modification (a write-side operation); this is a
+	 * read-only lookup and must not perturb i_version state. Dormant on
+	 * this guest regardless — see the struct comment in exec_image.h. */
+	u64 i_version = have_i_version ? inode_peek_iversion(inode) : 0;
+	struct wasm_exec_image *img;
+	void *buf;
+	loff_t pos;
+	ssize_t nread;
+
+	/*
+	 * Fast path: a cache HIT is served entirely under the spinlock, no
+	 * allocation, no mutex — this is the path every exec inside a
+	 * configure-loop-style churn takes after the first. (The memcmp
+	 * inside image_validators_match() runs under the spinlock too; it's
+	 * bounded by BINPRM_BUF_SIZE (256) bytes, not the whole image, so
+	 * this stays cheap.)
+	 */
+	spin_lock(&wasm_exec_image_lock);
+	list_for_each_entry(img, &wasm_exec_image_lru, lru) {
+		if (image_key_matches(img, s_dev, i_ino) &&
+				image_validators_match(img, size, mtime,
+					have_i_version, i_version,
+					head, head_len)) {
+			refcount_inc(&img->refs);
+			list_move(&img->lru, &wasm_exec_image_lru); /* MRU */
+			spin_unlock(&wasm_exec_image_lock);
+			return img;
+		}
+	}
+	spin_unlock(&wasm_exec_image_lock);
+
+	/* Miss: serialize the load against other concurrent misses. */
+	mutex_lock(&wasm_exec_image_load_mutex);
+
+	/* Re-check: another exec may have raced us and already inserted the
+	 * entry we're about to build while we waited for the mutex. */
+	spin_lock(&wasm_exec_image_lock);
+	list_for_each_entry(img, &wasm_exec_image_lru, lru) {
+		if (image_key_matches(img, s_dev, i_ino) &&
+				image_validators_match(img, size, mtime,
+					have_i_version, i_version,
+					head, head_len)) {
+			refcount_inc(&img->refs);
+			list_move(&img->lru, &wasm_exec_image_lru);
+			spin_unlock(&wasm_exec_image_lock);
+			mutex_unlock(&wasm_exec_image_load_mutex);
+			return img;
+		}
+	}
+	spin_unlock(&wasm_exec_image_lock);
+
+	/* A same-key entry with STALE validators is dropped from the cache
+	 * here (see the helper) so the fresh load below gets a clean slot;
+	 * done under the load mutex so it can't race a second miss doing the
+	 * same unhash. */
+	unhash_stale_and_put(s_dev, i_ino, size, mtime, have_i_version,
+			i_version, head, head_len);
+
+	/* Alloc + read OUTSIDE any lock: both can sleep. On a failure, evict
+	 * every idle entry and retry ONCE — see the file comment's reclaim
+	 * mechanism (1); this is what actually serves the failing alloc, not
+	 * the shrinker (registered below as best-effort background reclaim
+	 * only). */
+	buf = alloc_pages_exact(whole_size, GFP_KERNEL);
+	if (!buf) {
+		wasm_exec_image_evict_idle(ULONG_MAX);
+		buf = alloc_pages_exact(whole_size, GFP_KERNEL);
+		if (!buf) {
+			mutex_unlock(&wasm_exec_image_load_mutex);
+			return ERR_PTR(-ENOMEM);
+		}
+	}
+	pos = 0;
+	nread = kernel_read(file, buf, whole_size, &pos);
+	if (nread != (ssize_t)whole_size) {
+		free_pages_exact(buf, whole_size);
+		mutex_unlock(&wasm_exec_image_load_mutex);
+		return ERR_PTR(nread < 0 ? (int)nread : -EIO);
+	}
+
+	img = kzalloc(sizeof(*img), GFP_KERNEL);
+	if (!img) {
+		free_pages_exact(buf, whole_size);
+		mutex_unlock(&wasm_exec_image_load_mutex);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	img->s_dev = s_dev;
+	img->i_ino = i_ino;
+	img->size = size;
+	img->mtime = mtime;
+	img->have_i_version = have_i_version;
+	img->i_version = i_version;
+	img->buf = buf;
+	img->buf_size = whole_size;
+	/* 1 ref for the cache's own slot, 1 for the caller we're about to
+	 * return to — set together so the entry is never briefly visible on
+	 * the list at refcount 1 (which would make it look idle/evictable to
+	 * the shrinker before the caller has actually taken its copy). */
+	refcount_set(&img->refs, 2);
+
+	spin_lock(&wasm_exec_image_lock);
+	list_add(&img->lru, &wasm_exec_image_lru);
+	spin_unlock(&wasm_exec_image_lock);
+
+	mutex_unlock(&wasm_exec_image_load_mutex);
+
+	/* Reclaim mechanism (2): enforce the steady-state idle-byte cap now
+	 * that the new entry is inserted (and therefore itself eligible to
+	 * be counted/evicted once it goes idle later — this call only ever
+	 * evicts entries OTHER than the one this caller now holds a live
+	 * reference to, since a fresh entry starts at refcount 2). Done
+	 * outside the load mutex: eviction takes only the spinlock.
+	 *
+	 * Evict only the EXCESS over the cap, not everything idle: this is a
+	 * steady-state budget, not an emergency (that's the ULONG_MAX call in
+	 * the alloc-failure path above) — evicting every idle entry here would
+	 * cold-start the exact warm LRU entries (e.g. clang's 57 MB image)
+	 * this cache exists to keep hot, the instant one over-cap insert
+	 * happens. wasm_exec_image_evict_idle()'s LRU-first walk already stops
+	 * as soon as its running total reaches the budget it's given, so
+	 * handing it the excess (not the whole idle total) evicts "just
+	 * enough to get back under the cap", matching its own doc comment.
+	 *
+	 * Benign TOCTOU: idle_bytes() and the eviction walk each take the
+	 * spinlock independently, so an entry can flip from idle to pinned
+	 * (or vice versa) between the two. That only ever makes the eviction
+	 * slightly under- or over-shoot the cap for one insert, never a
+	 * correctness issue (evict_idle() only ever touches genuinely-idle
+	 * entries at the moment IT samples them). */
+	unsigned long idle = wasm_exec_image_idle_bytes();
+
+	if (idle > WASM_EXEC_IMAGE_CACHE_CAP_BYTES)
+		wasm_exec_image_evict_idle(idle - WASM_EXEC_IMAGE_CACHE_CAP_BYTES);
+
+	return img;
+}
+
+/* ---- shrinker: best-effort BACKGROUND reclaim of idle images under system
+ * memory pressure (reclaim mechanism 3 in the file comment above) — NOT the
+ * mechanism that serves this cache's own failing allocations (that's
+ * wasm_exec_image_evict_idle(), called synchronously from the miss path) and
+ * NOT what bounds steady-state retention (that's the byte cap, also
+ * enforced via wasm_exec_image_evict_idle()). Still useful: frees this
+ * cache's idle memory back for an unrelated allocation elsewhere in the
+ * system. */
+
+static unsigned long wasm_exec_image_shrink_count(struct shrinker *shrinker,
+		struct shrink_control *sc)
+{
+	unsigned long bytes = wasm_exec_image_idle_bytes();
+
+	/* Reported in PAGES (the generic shrinker "objects" unit), matching
+	 * scan_objects()'s own return value below. */
+	return bytes ? (bytes >> PAGE_SHIFT) : SHRINK_EMPTY;
+}
+
+static unsigned long wasm_exec_image_shrink_scan(struct shrinker *shrinker,
+		struct shrink_control *sc)
+{
+	/*
+	 * sc->nr_to_scan is nominally in "objects" (per-entry) units in the
+	 * generic shrinker contract, but this cache's natural unit is BYTES
+	 * (whole-image granularity, wildly variable size per entry) — we
+	 * scale it up to a byte budget and report freed PAGES back, matching
+	 * count_objects() above. This is a harmless accounting-unit skew
+	 * (the generic shrinker core just compares the returned count against
+	 * its own bookkeeping, not against a strict objects-in/pages-out
+	 * identity), not a correctness issue: a mismatch only means the
+	 * shrinker core's internal "how much did that scan actually free"
+	 * accounting is approximate for this shrinker, which is exactly the
+	 * kind of imprecision the "best-effort background reclaim" framing
+	 * above already accepts.
+	 */
+	unsigned long max_bytes = sc->nr_to_scan << PAGE_SHIFT;
+	unsigned long freed = wasm_exec_image_evict_idle(max_bytes);
+
+	return freed ? (freed >> PAGE_SHIFT) : SHRINK_STOP;
+}
+
+static int __init wasm_exec_image_cache_init(void)
+{
+	struct shrinker *shrinker = shrinker_alloc(0, "wasm-exec-image");
+
+	if (!shrinker) {
+		pr_warn("wasm exec-image cache: shrinker_alloc failed, idle "
+			"images will only be reclaimed synchronously on an "
+			"allocation failure or the insert-time byte cap, "
+			"never proactively under unrelated memory pressure\n");
+		return 0;
+	}
+	shrinker->count_objects = wasm_exec_image_shrink_count;
+	shrinker->scan_objects = wasm_exec_image_shrink_scan;
+	/* batch=1 (not the shrinker-core default): this cache's freeable
+	 * count and per-image size make the default batching reach the
+	 * generic core's scan threshold only at very high reclaim priority
+	 * (do_shrink_slab's total_scan math) — with a handful of idle
+	 * multi-page-order entries, that priority may never be reached
+	 * before direct reclaim gives up. batch=1 lets background reclaim
+	 * actually engage this shrinker at ordinary priorities; it changes
+	 * nothing about mechanisms (1)/(2) above, which never go through
+	 * the shrinker core at all. */
+	shrinker->batch = 1;
+	shrinker_register(shrinker);
+	return 0;
+}
+late_initcall(wasm_exec_image_cache_init);
