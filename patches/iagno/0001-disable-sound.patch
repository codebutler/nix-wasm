Disable libcanberra sound: the wasm guest has no audio device and no
libcanberra cross build. iagno is Vala with the dist tarball shipping the
generated C, so this patches the SHIPPED iagno.c (stable in the pinned
tarball): the one ca_gtk_play_for_widget call site becomes a no-op and the
unreachable ca_strerror reference is replaced so nothing links against
canberra. Revisit if the guest grows an audio stack.

--- a/src/iagno.c
+++ b/src/iagno.c
@@ -32,8 +32,7 @@
 #include <locale.h>
 #include <glib/gi18n-lib.h>
 #include <stdio.h>
-#include <canberra-gtk.h>
-#include <canberra.h>
+/* sound disabled on the wasm guest: no audio device, no libcanberra */
 
 
 #define TYPE_IAGNO (iagno_get_type ())
@@ -2373,7 +2372,7 @@
 #line 482 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
 	_tmp15_ = path;
 #line 482 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
-	_tmp16_ = ca_gtk_play_for_widget ((GtkWidget*) _tmp13_, (guint32) 0, CA_PROP_MEDIA_NAME, _tmp14_, CA_PROP_MEDIA_FILENAME, _tmp15_, NULL);
+	_tmp16_ = 0; (void) _tmp13_; (void) _tmp14_; (void) _tmp15_; /* sound disabled: no libcanberra on the wasm guest */
 #line 482 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
 	r = _tmp16_;
 #line 485 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
@@ -2389,7 +2388,7 @@
 #line 486 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
 		_tmp19_ = r;
 #line 486 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
-		_tmp20_ = ca_strerror (_tmp19_);
+		_tmp20_ = "sound disabled"; (void) _tmp19_;
 #line 486 "/mnt/test/jhbuild/jhbuild/iagno/src/iagno.vala"
 		g_warning ("iagno.vala:486: Error playing %s: %s", _tmp18_, _tmp20_);
 #line 2396 "iagno.c"
