diff --git a/sommelier-xdg-decoration.cc b/sommelier-xdg-decoration.cc
new file mode 100644
index 0000000..a96a841
--- /dev/null
+++ b/sommelier-xdg-decoration.cc
@@ -0,0 +1,167 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// zxdg_decoration_manager_v1 passthrough (xdg-decoration-unstable-v1).
+//
+// Sommelier's clients are compositor-decorated or self-decorated at the HOST
+// compositor's discretion; a client that wants server-side decorations (e.g. a
+// bare wl_shm app that draws no frame of its own, like wl-eyes) must be able to
+// negotiate that with the host. This module forwards the protocol 1:1: the
+// manager global is advertised to clients only when the host compositor offers
+// it (see the registry handler in sommelier.cc), get_toplevel_decoration is
+// re-issued against the host xdg_toplevel proxy, set_mode/unset_mode forward,
+// and the host's configure(mode) event is relayed back. No transform is needed
+// — the protocol carries only mode enums, no coordinates.
+//
+// Follows the sommelier-viewporter.cc passthrough pattern (direct proxy calls,
+// no codegen shim indirection).
+
+#include <assert.h>
+#include <stdlib.h>
+
+#include "sommelier.h"           // NOLINT(build/include_directory)
+#include "sommelier-xdg-shell.h"  // NOLINT(build/include_directory)
+
+#include "xdg-decoration-unstable-v1-client-protocol.h"  // NOLINT(build/include_directory)
+#include "xdg-decoration-unstable-v1-server-protocol.h"  // NOLINT(build/include_directory)
+
+struct sl_host_xdg_decoration_manager {
+  struct sl_context* ctx;
+  struct wl_resource* resource;
+  struct zxdg_decoration_manager_v1* proxy;
+};
+
+struct sl_host_xdg_toplevel_decoration {
+  struct sl_context* ctx;
+  struct wl_resource* resource;
+  struct zxdg_toplevel_decoration_v1* proxy;
+};
+
+static void sl_xdg_toplevel_decoration_destroy(struct wl_client* client,
+                                               struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+static void sl_xdg_toplevel_decoration_set_mode(struct wl_client* client,
+                                                struct wl_resource* resource,
+                                                uint32_t mode) {
+  struct sl_host_xdg_toplevel_decoration* host =
+      static_cast<sl_host_xdg_toplevel_decoration*>(
+          wl_resource_get_user_data(resource));
+
+  zxdg_toplevel_decoration_v1_set_mode(host->proxy, mode);
+}
+
+static void sl_xdg_toplevel_decoration_unset_mode(struct wl_client* client,
+                                                  struct wl_resource* resource) {
+  struct sl_host_xdg_toplevel_decoration* host =
+      static_cast<sl_host_xdg_toplevel_decoration*>(
+          wl_resource_get_user_data(resource));
+
+  zxdg_toplevel_decoration_v1_unset_mode(host->proxy);
+}
+
+static const struct zxdg_toplevel_decoration_v1_interface
+    sl_xdg_toplevel_decoration_implementation = {
+        sl_xdg_toplevel_decoration_destroy,
+        sl_xdg_toplevel_decoration_set_mode,
+        sl_xdg_toplevel_decoration_unset_mode,
+};
+
+static void sl_xdg_toplevel_decoration_configure(
+    void* data, struct zxdg_toplevel_decoration_v1* decoration, uint32_t mode) {
+  struct sl_host_xdg_toplevel_decoration* host =
+      static_cast<sl_host_xdg_toplevel_decoration*>(data);
+
+  zxdg_toplevel_decoration_v1_send_configure(host->resource, mode);
+}
+
+static const struct zxdg_toplevel_decoration_v1_listener
+    sl_xdg_toplevel_decoration_listener = {
+        sl_xdg_toplevel_decoration_configure,
+};
+
+static void sl_destroy_host_xdg_toplevel_decoration(
+    struct wl_resource* resource) {
+  struct sl_host_xdg_toplevel_decoration* host =
+      static_cast<sl_host_xdg_toplevel_decoration*>(
+          wl_resource_get_user_data(resource));
+
+  zxdg_toplevel_decoration_v1_destroy(host->proxy);
+  wl_resource_set_user_data(resource, nullptr);
+  delete host;
+}
+
+static void sl_xdg_decoration_manager_destroy(struct wl_client* client,
+                                              struct wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+static void sl_xdg_decoration_manager_get_toplevel_decoration(
+    struct wl_client* client,
+    struct wl_resource* resource,
+    uint32_t id,
+    struct wl_resource* toplevel_resource) {
+  struct sl_host_xdg_decoration_manager* host =
+      static_cast<sl_host_xdg_decoration_manager*>(
+          wl_resource_get_user_data(resource));
+  struct sl_host_xdg_toplevel* host_toplevel =
+      static_cast<sl_host_xdg_toplevel*>(
+          wl_resource_get_user_data(toplevel_resource));
+
+  struct sl_host_xdg_toplevel_decoration* decoration =
+      new sl_host_xdg_toplevel_decoration();
+  decoration->ctx = host->ctx;
+  decoration->resource = wl_resource_create(
+      client, &zxdg_toplevel_decoration_v1_interface, 1, id);
+  wl_resource_set_implementation(decoration->resource,
+                                 &sl_xdg_toplevel_decoration_implementation,
+                                 decoration,
+                                 sl_destroy_host_xdg_toplevel_decoration);
+  decoration->proxy = zxdg_decoration_manager_v1_get_toplevel_decoration(
+      host->proxy, host_toplevel->proxy);
+  zxdg_toplevel_decoration_v1_add_listener(
+      decoration->proxy, &sl_xdg_toplevel_decoration_listener, decoration);
+}
+
+static const struct zxdg_decoration_manager_v1_interface
+    sl_xdg_decoration_manager_implementation = {
+        sl_xdg_decoration_manager_destroy,
+        sl_xdg_decoration_manager_get_toplevel_decoration,
+};
+
+static void sl_destroy_host_xdg_decoration_manager(
+    struct wl_resource* resource) {
+  struct sl_host_xdg_decoration_manager* host =
+      static_cast<sl_host_xdg_decoration_manager*>(
+          wl_resource_get_user_data(resource));
+
+  zxdg_decoration_manager_v1_destroy(host->proxy);
+  wl_resource_set_user_data(resource, nullptr);
+  delete host;
+}
+
+static void sl_bind_host_xdg_decoration_manager(struct wl_client* client,
+                                                void* data,
+                                                uint32_t version,
+                                                uint32_t id) {
+  struct sl_context* ctx = (struct sl_context*)data;
+  struct sl_host_xdg_decoration_manager* host =
+      new sl_host_xdg_decoration_manager();
+  host->ctx = ctx;
+  host->resource =
+      wl_resource_create(client, &zxdg_decoration_manager_v1_interface, 1, id);
+  wl_resource_set_implementation(host->resource,
+                                 &sl_xdg_decoration_manager_implementation,
+                                 host, sl_destroy_host_xdg_decoration_manager);
+  host->proxy = static_cast<zxdg_decoration_manager_v1*>(wl_registry_bind(
+      wl_display_get_registry(ctx->display), ctx->xdg_decoration_manager->id,
+      &zxdg_decoration_manager_v1_interface, 1));
+}
+
+struct sl_global* sl_xdg_decoration_manager_global_create(
+    struct sl_context* ctx) {
+  return sl_global_create(ctx, &zxdg_decoration_manager_v1_interface, 1, ctx,
+                          sl_bind_host_xdg_decoration_manager);
+}
